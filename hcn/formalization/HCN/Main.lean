import HCN.Assembly
import HCN.Statements.GeneralCS
import HCN.Statements.ClassPartition

/-!
# HCN: the imaginary quadratic fields of class number at most two (solution side)

GENERATED from hcn/certificates/Main.lean.in by hcn/certificates/gen_range.py (do not edit): the sets are read from
HCNChallenges/ClassNumberLeTwo.lean (itself generated by gen_sets.py), never typed by hand.

`HCN.classNumber_le_two_iff` and `HCN.classNumber_eq_two_iff` are the two statements of
HCNChallenges/ClassNumberLeTwo.lean, proved without Heegner, Baker or Stark:
* `HCN.Statements.GeneralCS`: Chowla-Selberg for a general positive form, the sharp remainder `Bg`, and `Bg_mono`;
  discharges `HCN.Assembly.CSFacts` (`csFacts`);
* `HCN.Statements.ClassPartition`: `ζ_K = Σ_Cl ½ Z_{Q_{J_Cl}}` with Hermite representatives, `1 ≤ a ≤ (2/3)√d`;
  discharges `HCN.Assembly.EFacts` (`eFacts`);
* `HCN.Numerics.Threshold`, `HCN.Assembly.LowerBound`: `4778 ≤ dOf m ⇒ 3 ≤ classNumber K`, from openai/math's
  zero-free region `re s > 7/8` (CN-1's positivity);
* `HCN.Finite.*` and `HCN.Assembly.Range`: `dOf m < 4778`, outside the 27 ⇒ `3 ≤ classNumber K`; the bridge-lite for
  the eighteen, and CN-1's `classNumber_eq_one_iff` for the nine;
* `HCN.Assembly`: one `lt_or_ge (dOf m) 4778`.
-/

set_option autoImplicit false

open NumberField

namespace HCN

theorem csFacts : Assembly.CSFacts :=
  ⟨CS.CS_main_general, CS.differentiableOn_mainTermg_add_Eg, CS.mainTermg_seven_eighths,
    CS.norm_Eg_seven_eighths_le, CS.Bg_mono⟩

theorem eFacts {K : Type*} [Field K] [NumberField K] {m : ℕ} {α : K} (hα : α ^ 2 = -(m : K))
    (hK : Module.finrank ℚ K = 2) (hm : Squarefree m) : Assembly.EFacts hα :=
  ⟨fun h => h.absNorm_eq hα hK hm, fun h => h.C_dvd_A hα hK hm,
    fun hm1 hm3 => Epstein.exists_classReps hα hK hm hm1 hm3⟩

theorem classNumber_le_two_iff (K : Type*) [Field K] [NumberField K]
    (hK : Module.finrank ℚ K = 2)
    (m : ℕ) (hm : Squarefree m) (hsq : ∃ α : K, α ^ 2 = -(m : K)) :
    classNumber K ≤ 2 ↔ m ∈ ({1, 2, 3, 7, 11, 19, 43, 67, 163, 5, 6, 10, 13, 15, 22, 35, 37, 51, 58, 91, 115, 123, 187, 235, 267, 403, 427} : Finset ℕ) :=
  Assembly.classNumber_le_two_iff_of_facts csFacts K hK m hm hsq fun _ hα => eFacts hα hK hm

theorem classNumber_eq_two_iff (K : Type*) [Field K] [NumberField K]
    (hK : Module.finrank ℚ K = 2)
    (m : ℕ) (hm : Squarefree m) (hsq : ∃ α : K, α ^ 2 = -(m : K)) :
    classNumber K = 2 ↔ m ∈ ({5, 6, 10, 13, 15, 22, 35, 37, 51, 58, 91, 115, 123, 187, 235, 267, 403, 427} : Finset ℕ) :=
  Assembly.classNumber_eq_two_iff_of_facts csFacts K hK m hm hsq fun _ hα => eFacts hα hK hm

end HCN
