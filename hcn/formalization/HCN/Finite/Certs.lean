namespace HCN.Finite.Certs

/-- The 1429 squarefree radicands `m` with `dOf m ≤ 4777` and `h(-dOf m) ≥ 3`. -/
def hcnGe3 : List ℕ := chunk1 ++ chunk2 ++ chunk3 ++ chunk4 ++ chunk5 ++ chunk6 ++ chunk7 ++ chunk8 ++ chunk9 ++ chunk10 ++ chunk11 ++ chunk12 ++ chunk13 ++ chunk14 ++ chunk15

theorem length_hcnGe3 : hcnGe3.length = 1429 := by decide +kernel

theorem exists_cert_of_mem : ∀ m ∈ hcnGe3, ∃ ps, ClassCert (tOf m) (cOf m) ps ∧ 2 ≤ weight ps := by
  unfold hcnGe3
  exact List.forall_mem_append.mpr ⟨List.forall_mem_append.mpr ⟨List.forall_mem_append.mpr ⟨List.forall_mem_append.mpr ⟨List.forall_mem_append.mpr ⟨List.forall_mem_append.mpr ⟨List.forall_mem_append.mpr ⟨List.forall_mem_append.mpr ⟨List.forall_mem_append.mpr ⟨List.forall_mem_append.mpr ⟨List.forall_mem_append.mpr ⟨List.forall_mem_append.mpr ⟨List.forall_mem_append.mpr ⟨List.forall_mem_append.mpr ⟨exists_cert_chunk1, exists_cert_chunk2⟩, exists_cert_chunk3⟩, exists_cert_chunk4⟩, exists_cert_chunk5⟩, exists_cert_chunk6⟩, exists_cert_chunk7⟩, exists_cert_chunk8⟩, exists_cert_chunk9⟩, exists_cert_chunk10⟩, exists_cert_chunk11⟩, exists_cert_chunk12⟩, exists_cert_chunk13⟩, exists_cert_chunk14⟩, exists_cert_chunk15⟩

/-- **The finite lower bound, assembled.** For `K` of degree two containing `√-m`, `m` squarefree and
in `hcnGe3`, the class number is at least three. -/
theorem three_le_classNumber_of_mem {K : Type*} [Field K] [NumberField K] (hK : finrank ℚ K = 2)
    {m : ℕ} (hm : Squarefree m) (hsq : ∃ α : K, α ^ 2 = -(m : K)) (hmem : m ∈ hcnGe3) :
    3 ≤ classNumber K := by
  obtain ⟨ps, hps, hw⟩ := exists_cert_of_mem m hmem
  have := HCN.Finite.le_classNumber_of_cert_foundations hK hm hsq hps
  omega

