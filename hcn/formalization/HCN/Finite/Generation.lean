import Mathlib

/-!
# HCN.Finite.Generation: the class group is generated by the primes below the Minkowski bound

Mathlib's `NumberField.exists_ideal_in_class_of_norm_le` (ClassNumber.lean:77) puts in every
class an integral ideal `I` of norm at most the Minkowski bound; `I` is the product of its prime factors
(`Ideal.prod_normalizedFactors_eq_self`), each of norm at most `N(I)`. So if the class of every nonzero prime of norm
at most the bound lies in a submonoid `S`, then every class does. This is the argument of Mathlib's
`RingOfIntegers.isPrincipalIdealRing_of_isPrincipal_of_norm_le_of_isPrime` (ClassNumber.lean:116), with the
submonoid of principal ideals replaced by the preimage of `S`. Mathlib only.
-/

open NumberField NumberField.InfinitePlace Ideal Module Real
open scoped nonZeroDivisors

namespace HCN.Finite

variable {K : Type*} [Field K] [NumberField K]

/-- **Generation.** If the class of every nonzero prime ideal of norm at most the Minkowski bound lies in the
submonoid `S`, then every ideal class lies in `S`. The bound is written exactly as Mathlib's local notation `M K`
expands (as in CN-1's `le_two_thirds_sqrt_of_le_minkowski`). -/
theorem mem_of_forall_prime_le_minkowski (S : Submonoid (ClassGroup (𝓞 K)))
    (h : ∀ I : (Ideal (𝓞 K))⁰, (I : Ideal (𝓞 K)).IsPrime →
      (absNorm (I : Ideal (𝓞 K)) : ℝ) ≤ (4 / π) ^ nrComplexPlaces K *
        ((finrank ℚ K).factorial / (finrank ℚ K) ^ (finrank ℚ K) * √|(discr K : ℝ)|) →
      ClassGroup.mk0 I ∈ S) (C : ClassGroup (𝓞 K)) : C ∈ S := by
  obtain ⟨I, rfl, hI⟩ := exists_ideal_in_class_of_norm_le C
  let T : Submonoid (Ideal (𝓞 K)) :=
    { carrier := {J | ∀ hJ : J ∈ (Ideal (𝓞 K))⁰, ClassGroup.mk0 ⟨J, hJ⟩ ∈ S}
      mul_mem' := by
        intro a b ha hb hab
        have hab0 : a * b ≠ 0 := nonZeroDivisors.ne_zero hab
        have ha0 : a ∈ (Ideal (𝓞 K))⁰ := mem_nonZeroDivisors_of_ne_zero (left_ne_zero_of_mul hab0)
        have hb0 : b ∈ (Ideal (𝓞 K))⁰ := mem_nonZeroDivisors_of_ne_zero (right_ne_zero_of_mul hab0)
        have hmul : ClassGroup.mk0 ⟨a * b, hab⟩ =
            ClassGroup.mk0 ⟨a, ha0⟩ * ClassGroup.mk0 ⟨b, hb0⟩ := by
          rw [← map_mul]; rfl
        rw [hmul]
        exact S.mul_mem (ha ha0) (hb hb0)
      one_mem' := by
        intro h1
        have hone : ClassGroup.mk0 ⟨(1 : Ideal (𝓞 K)), h1⟩ = 1 := by
          rw [← map_one (ClassGroup.mk0 (R := 𝓞 K))]; rfl
        rw [hone]
        exact S.one_mem }
  have hmem : (I : Ideal (𝓞 K)) ∈ T := by
    rw [← Ideal.prod_normalizedFactors_eq_self (nonZeroDivisors.coe_ne_zero I)]
    refine Submonoid.multiset_prod_mem _ _ (fun J hJ => ?_)
    intro hJ0
    have hJp : J.IsPrime := ((mem_normalizedFactors_iff (nonZeroDivisors.coe_ne_zero I)).mp hJ).1
    refine h ⟨J, hJ0⟩ hJp ?_
    exact (Nat.cast_le.mpr <| Nat.le_of_dvd (absNorm_pos_of_nonZeroDivisors I) <|
      absNorm_dvd_absNorm_of_le <| Ideal.le_of_dvd <|
        UniqueFactorizationMonoid.dvd_of_mem_normalizedFactors hJ).trans hI
  exact hmem I.2

end HCN.Finite
